# This file '.env' was derived from the sample file '.podman_env_https'.
# It contains the settings that scripts/install.sh uses to generate the
# Quadlet units and the environment files of the containers.
# The variable names are the same as in otobo-docker, so an existing .env
# can be used as a starting point.
#
# Run scripts/install.sh again after changing this file.

# OTOBO_SERVICES lists the services that are installed, similar to COMPOSE_FILE
# in otobo-docker. The services db, elastic, web and daemon are always needed.
# - nginx: HTTPS reverse proxy. Without nginx the web server is published via HTTP.
# - redis: caching with Redis
OTOBO_SERVICES=db elastic redis web daemon nginx

# Database configuration
# OTOBO_DB_ROOT_PASSWORD must be set
OTOBO_DB_ROOT_PASSWORD=

# Set this to a value in bytes to overwrite the default query size set for OTOBO
#OTOBO_DB_QUERY_CACHE_SIZE=

# HTTP options
# In the HTTPS case http:// redirects to https://

# Rootless Podman can not publish ports below 1024 unless
# net.ipv4.ip_unprivileged_port_start is lowered, see sysctl/90-otobo.conf.
# Therefore the defaults are 8080 and 8443. Set 80 and 443 after enabling the
# sysctl setting, or keep the high ports behind a reverse proxy of your organisation.
OTOBO_WEB_HTTP_PORT=8080

# Set OTOBO_WEB_HTTP_IPADDR when only requests addressed to a specific IP should be served.
#OTOBO_WEB_HTTP_IPADDR=<your special ip address>

# The option OTOBO_WEB_OPTION influences which webserver is used with which options.
# The default value is 'deployment'
#OTOBO_WEB_OPTION=deployment              # the default, should be used in production and most times during development
#OTOBO_WEB_OPTION=development             # can be useful during development, sets PLACK_ENV to 'development'

# HTTPS options

# See the note on ports below 1024 above.
OTOBO_WEB_HTTPS_PORT=8443

# Set OTOBO_WEB_HTTPS_IPADDR when only requests addressed to a specific IP should be served.
#OTOBO_WEB_HTTPS_IPADDR=<your special ip address>

# The settings OTOBO_NGINX_SSL_CERTIFICATE and OTOBO_NGINX_SSL_CERTIFICATE_KEY
# are mandatory when HTTPS is used.
# The configured pathes must be absolute pathes that are available in the container.
# The volume otobo_nginx_ssl is mounted at /etc/nginx/ssl, see the documentation
# for how to import the files into the volume.
#OTOBO_NGINX_SSL_CERTIFICATE=/etc/nginx/ssl/ssl-cert.crt
#OTOBO_NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/ssl/ssl-key.key
OTOBO_NGINX_SSL_CERTIFICATE=
OTOBO_NGINX_SSL_CERTIFICATE_KEY=

# Shared secret between the nginx reverse proxy and OTOBO.
# nginx sends it in the HTTP header X-OTOBO-Proxy-Secret. OTOBO only believes
# the X-Forwarded-* headers and (if 'AuthModule::HTTPBasicAuth::TrustProxyHeader'
# is enabled) the Remote-User header of requests that carry the correct secret.
# Generate a value with e.g.:  openssl rand -hex 32
# Leaving this empty keeps the legacy behaviour, which is not recommended.
OTOBO_PROXY_SECRET=

# provide a custom Nginx config template dir, usually not needed
#NGINX_ENVSUBST_TEMPLATE_DIR=/etc/nginx/config/template-custom

# Elasticsearch options
OTOBO_ELASTICSEARCH_ES_JAVA_OPTS=-Xms512m -Xmx512m

################################################################################
# Container images
#
# Podman requires fully qualified image names, including the registry.
# This is also the place where a local registry is configured: simply
# replace 'docker.io' with the address of your registry, e.g.
#   OTOBO_IMAGE_OTOBO=registry.example.com/rotheross/otobo:rel-11_1_0-beta3
# A registry with a self-signed certificate must be declared in
# /etc/containers/registries.conf (insecure = true), see
# 'man containers-registries.conf'.
################################################################################

################################################################################
# The image for the service 'db' can be specified explicitly.
# The default is docker.io/library/mariadb:lts-noble
################################################################################
#OTOBO_IMAGE_DB=

################################################################################
# The image tag is fixed to a specific release.
# You may also choose to always stay on the latest release with: latest-11_1
# The default is docker.io/rotheross/otobo:rel-11_1_0-beta3
################################################################################

# Examples:
#OTOBO_IMAGE_OTOBO=docker.io/rotheross/otobo:rel-11_1_0-beta3
#OTOBO_IMAGE_OTOBO=docker.io/rotheross/otobo:latest-11_1
#OTOBO_IMAGE_OTOBO=registry.example.com/rotheross/otobo:rel-11_1_0-beta3

################################################################################
# The image tag is fixed to a specific release.
# The default is docker.io/rotheross/otobo-elasticsearch:rel-11_1_0-beta3
################################################################################

# Examples:
#OTOBO_IMAGE_OTOBO_ELASTICSEARCH=docker.io/rotheross/otobo-elasticsearch:rel-11_1_0-beta3
#OTOBO_IMAGE_OTOBO_ELASTICSEARCH=docker.io/rotheross/otobo-elasticsearch:latest-11_1

################################################################################
# The image for the service 'redis' can be specified explicitly.
# The default is docker.io/library/redis:8-bookworm
################################################################################
#OTOBO_IMAGE_REDIS=

