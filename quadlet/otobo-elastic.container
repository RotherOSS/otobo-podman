# Elasticsearch for OTOBO, derived from the service 'elastic' in otobo-base.yml.
# Requires vm.max_map_count=262144 on the host, see sysctl/90-otobo.conf.
# This is a template, see otobo-db.container.

[Unit]
Description=OTOBO search engine (Elasticsearch)
PartOf=otobo.target
# Dependencies on the network and volume units are added by Quadlet automatically.

[Container]
Image=${OTOBO_IMAGE_OTOBO_ELASTICSEARCH}
ContainerName=otobo-elastic
Network=otobo.network
NetworkAlias=elastic
SecurityLabelLevel=s0
Volume=otobo-elasticsearch-data.volume:/usr/share/elasticsearch/data

DropCapability=ALL
AddCapability=CAP_SYS_CHROOT
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID

# discovery.type, xpack.security.enabled and ES_JAVA_OPTS, generated from .env
EnvironmentFile=${OTOBO_ENV_DIR}/elastic.env

HealthCmd=curl --silent --fail 'http://localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s' || exit 1
HealthInterval=30s
HealthStartPeriod=120s
Notify=healthy

LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=otobo.target
