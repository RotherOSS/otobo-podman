# nginx reverse proxy providing HTTPS for OTOBO, derived from the service
# 'nginx' in otobo-override-https.yml.
# This is a template, see otobo-db.container.

[Unit]
Description=OTOBO reverse proxy (nginx, HTTPS)
PartOf=otobo.target
# Dependencies on the network and volume units are added by Quadlet automatically.
After=otobo-web.service
Requires=otobo-web.service

[Container]
Image=${OTOBO_IMAGE_OTOBO_NGINX}
ContainerName=otobo-nginx
Network=otobo.network
NetworkAlias=nginx
Volume=otobo-nginx-ssl.volume:/etc/nginx/ssl

# Capabilities nginx needs to drop privileges after binding its ports.
DropCapability=ALL
AddCapability=CAP_SYS_CHROOT
AddCapability=CAP_CHOWN
AddCapability=CAP_DAC_OVERRIDE
AddCapability=CAP_SETGID
AddCapability=CAP_SETUID

# The HTTP port only redirects to HTTPS.
PublishPort=${OTOBO_WEB_HTTPS_IPADDR}:${OTOBO_WEB_HTTPS_PORT}:8443
PublishPort=${OTOBO_WEB_HTTP_IPADDR}:${OTOBO_WEB_HTTP_PORT}:8080

# OTOBO_NGINX_* settings, certificate paths and the proxy secret, generated from .env
EnvironmentFile=${OTOBO_ENV_DIR}/nginx.env

HealthCmd=service nginx status || exit 1
HealthInterval=30s
Notify=healthy

LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=otobo.target
