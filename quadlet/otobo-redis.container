# Redis cache for OTOBO, derived from docker-compose/caching/redis.yml.
# This is a template, see otobo-db.container.

[Unit]
Description=OTOBO cache (Redis)
PartOf=otobo.target
# Dependencies on the network unit are added by Quadlet automatically.

[Container]
Image=${OTOBO_IMAGE_REDIS}
ContainerName=otobo-redis
Network=otobo.network
NetworkAlias=redis
SecurityLabelLevel=s0

User=redis
Group=redis
DropCapability=ALL

# No persistence, Redis is only used as a cache. Quadlet drops empty
# arguments, so the empty value for --save has to be passed via a shell.
Exec=sh -c "exec redis-server --save \"\""

HealthCmd=redis-cli ping
HealthInterval=30s
Notify=healthy

LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=otobo.target
