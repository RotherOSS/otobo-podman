# OTOBO daemon (scheduler, generic agent, mail fetching, ...), derived from the
# service 'daemon' in otobo-base.yml. Shares /opt/otobo with the web container.
# This is a template, see otobo-db.container.

[Unit]
Description=OTOBO daemon
PartOf=otobo.target
# Dependencies on the network and volume units are added by Quadlet automatically.
After=otobo-web.service
Requires=otobo-web.service

[Container]
Image=${OTOBO_IMAGE_OTOBO}
ContainerName=otobo-daemon
Network=otobo.network
NetworkAlias=daemon
SecurityLabelLevel=s0
Volume=otobo-opt-otobo.volume:/opt/otobo

DropCapability=ALL

Exec=daemon

HealthCmd=./bin/otobo.Daemon.pl status | grep 'Daemon running'
HealthInterval=60s
HealthStartPeriod=120s

LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=otobo.target
