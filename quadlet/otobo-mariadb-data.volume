# Persistent storage of the MariaDB server. The volume name is the same as in
# otobo-docker, so a volume exported from Docker Compose can be imported here.

[Unit]
Description=OTOBO volume: MariaDB data

[Volume]
VolumeName=otobo_mariadb_data
